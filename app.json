{
  "expo": {
    "name": "IronVault",
    "slug": "ironvault",
    "scheme": "com.on333.ironvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.on333.ironvault",
      "buildNumber": "20",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.1077182608968-bsuekmvophah31fvpmoah14m8n360ho2"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.1077182608968-bsuekmvophah31fvpmoah14m8n360ho2"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.on333.ironvault",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "94beb858-cbb1-40c7-9cc6-122d727a11df"
      }
    },
    "owner": "on333"
  }
}
